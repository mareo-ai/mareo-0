{
  "name": "mareo",
  "productName": "Mareo",
  "version": "0.2.8",
  "private": true,
  "description": "Mareo desktop host for DeepSeek Harness",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "stage:runtime": "node scripts/stage-runtime.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs .staging",
    "verify:brand": "npm run build && node scripts/verify-brand.mjs",
    "start": "npm run build && npm run stage:runtime && electron-forge start",
    "dev": "npm run build && node scripts/dev.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "make": "npm run build && npm run stage:runtime && electron-forge make --arch=arm64",
    "stage:runtime:win": "node scripts/stage-runtime.mjs --platform win32 --arch x64",
    "check:node:win": "node scripts/stage-runtime.mjs --platform win32 --arch x64 --check-node-runtime",
    "make:win": "npm run build && npm run stage:runtime:win && electron-forge make --platform win32 --arch=x64",
    "generate:ico": "node scripts/generate-ico.mjs",
    "publish:oss": "node scripts/publish-oss.mjs",
    "downloads:oss": "node --env-file-if-exists=.env.oss scripts/oss-downloads.mjs",
    "deploy:site": "node scripts/deploy-site.mjs",
    "verify:package": "node scripts/verify-runtime.mjs out/Mareo-darwin-arm64/Mareo.app/Contents/Resources",
    "release": "node scripts/release.mjs",
    "server:start": "npm --prefix server run start",
    "server:issue-token": "npm --prefix server run issue-token",
    "server:test": "npm --prefix server run test"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@types/node": "26.4.1",
    "ali-oss": "^6.23.0",
    "electron": "44.2.0",
    "png-to-ico": "^3.0.2",
    "typescript": "7.0.2"
  }
}
