{
  "name": "mareo-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mareo gateway: authenticates Mareo clients and proxies model traffic to DeepSeek with usage accounting",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node --env-file-if-exists=.env dist/src/main.js",
    "issue-token": "npm run build && node --env-file-if-exists=.env dist/src/issue-token.js",
    "metrics": "npm run build && node --env-file-if-exists=.env dist/src/metrics.js",
    "stats:page": "npm run build && node --env-file-if-exists=.env dist/src/stats-page.js",
    "cost": "npm run build && node --env-file-if-exists=.env dist/src/cost-report.js",
    "config": "npm run build && node --env-file-if-exists=.env dist/src/config-cli.js",
    "credit": "npm run build && node --env-file-if-exists=.env dist/src/credit-cli.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "payment": "npm run build && node --env-file-if-exists=.env dist/src/payment-cli.js"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "nodemailer": "^10.0.1",
    "qrcode": "^1.5.4",
    "undici": "^7.30.1"
  }
}
