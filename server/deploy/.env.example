# Copy to server/deploy/.env and fill in. Never commit .env.

# Public domain the gateway is served under (used by the TLS config in front
# of the container; the container itself does not need it).
DOMAIN=api.mareo.cn

# The container listens on all interfaces; docker-compose publishes it to the
# host loopback only, so the outside world never reaches this port directly.
HOST=0.0.0.0
PORT=3000

# Your real DeepSeek API key. It exists only on this server, never on a user
# machine.
DEEPSEEK_API_KEY=

# Per-user daily request cap (0 disables the check).
DAILY_LIMIT=200

# SQLite path inside the container; ./data on the host is mounted there.
DB_PATH=data/mareo.db

# Inside the existing ./data bind mount; edits take effect on the next ad fetch.
SPONSORED_AD_FILE=data/sponsored-ad.json


# --- Email verification code delivery (Feishu/Lark SMTP) ---
# 未配置时：本地/测试走日志模式；生产环境发送会返回错误（不影响 token 登录）。
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@mareo.ai
SMTP_PASS=
SMTP_FROM=no-reply@mareo.ai

# --- 充值（微信支付 / 支付宝）---
# off  = 不启用（用户看不到充值入口）
# fake = 模拟通道，只给开发和测试用（用户同样看不到入口）
# live = 真实收钱
PAYMENT_MODE=off

# 支付平台回调的公网前缀，必须 HTTPS 且已备案；回调地址是
# <PAYMENT_PUBLIC_BASE_URL>/payment/notify/alipay（微信同理）。
PAYMENT_PUBLIC_BASE_URL=https://api.svc.mareo.cn

# 支付宝开放平台：应用 ID、应用私钥、支付宝公钥。
# 两个密钥既可以给文件路径（推荐，权限 600），也可以直接写内容。
# 应用私钥是本地生成的 PKCS#1 或 PKCS#8 PEM；支付宝公钥在开放平台查看。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=secrets/alipay_app_private.pem
ALIPAY_PUBLIC_KEY_PATH=secrets/alipay_public.pem
# 沙箱联调时指向沙箱网关；留空即生产网关。
ALIPAY_GATEWAY=

# 仅 PAYMENT_MODE=fake 时使用：模拟回调要带的共享密钥。
PAYMENT_FAKE_TOKEN=
